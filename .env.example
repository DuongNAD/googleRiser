# ==============================================================================
# SME AutoPilot — Environment Configuration Template
# AI Riser Vietnam 2026 (#BuildwithGoogleAI)
# ==============================================================================

# Server Runtime Configuration
PORT=8080
NODE_ENV=production
APP_MODE=DEMO

# Mock Mode Override (set to false when running with live Google credentials)
USE_MOCK_GOOGLE=true

# Google Gemini 2.0 API Key (Required for Live AI Mode)
GEMINI_API_KEY=

# Google Sheets Spreadsheet ID (Required for Live Sheets Mode)
GOOGLE_SHEETS_SPREADSHEET_ID=

# Gmail API OAuth Client ID / Credentials
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Google Maps Platform API Key (Places & Routes)
GOOGLE_MAPS_API_KEY=

# Firebase / Google Cloud Project Configuration
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
