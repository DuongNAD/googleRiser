{
  "name": "sme-autopilot",
  "version": "1.0.0",
  "description": "SME AutoPilot - Multimodal AI Operations Platform for Vietnamese Online Merchants (#BuildwithGoogleAI AI Riser Vietnam 2026)",
  "main": "backend/src/server.ts",
  "scripts": {
    "build": "npm run build:backend",
    "build:backend": "tsc",
    "build:frontend": "npm --prefix frontend run build",
    "setup": "npm install && npm --prefix frontend install && npm --prefix frontend run build",
    "demo": "npm --prefix frontend run build && ts-node backend/src/server.ts",
    "dev": "ts-node backend/src/server.ts",
    "dev:backend": "ts-node backend/src/server.ts",
    "dev:frontend": "npm --prefix frontend run dev",
    "start": "node dist/backend/src/server.js",
    "test": "node --expose-gc -r ts-node/register tests/runner.ts",
    "test:t1": "node --expose-gc -r ts-node/register tests/runner.ts --tier=tier1",
    "test:t2": "node --expose-gc -r ts-node/register tests/runner.ts --tier=tier2",
    "test:t3": "node --expose-gc -r ts-node/register tests/runner.ts --tier=tier3",
    "test:t4": "node --expose-gc -r ts-node/register tests/runner.ts --tier=tier4",
    "test:t5": "node --expose-gc -r ts-node/register tests/runner.ts --tier=tier5",
    "test:ai": "node --expose-gc -r ts-node/register backend/tests/ai/run_ai_tests.ts",
    "test:api": "node --expose-gc -r ts-node/register backend/tests/api/run_api_tests.ts",
    "test:all": "node --expose-gc -r ts-node/register tests/runner.ts && node --expose-gc -r ts-node/register backend/tests/ai/run_ai_tests.ts && node --expose-gc -r ts-node/register backend/tests/api/run_api_tests.ts"
  },
  "keywords": [
    "vietnam",
    "sme",
    "gemini",
    "google-cloud",
    "vietqr",
    "autopilot"
  ],
  "author": "AI Riser Team",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@googleapis/calendar": "^16.0.0",
    "@googleapis/gmail": "^18.0.0",
    "@googleapis/sheets": "^14.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1"
  }
}
